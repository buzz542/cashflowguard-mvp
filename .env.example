# ---- Server only: never expose these to the browser ----
ANTHROPIC_API_KEY=
# Model for reviews + photo OCR. Defaults to the model the app shipped with.
ANTHROPIC_MODEL=claude-sonnet-4-5

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Signing secret for the /api/stripe/webhook endpoint (Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=

# Supabase (Project Settings > API). The service role key bypasses RLS: server only.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string. Salts hashed IPs in the free-tier ledger.
IP_HASH_SALT=

# ---- Deadline reminders ----
# Resend API key + a sender on a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM=GuardConstruct <reminders@guardconstruct.com>
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Deadline extraction + reminders for Pro only (true) or everyone (false)
REMINDERS_PRO_ONLY=true
# Model for deadline extraction (defaults to ANTHROPIC_MODEL)
ANTHROPIC_EXTRACTION_MODEL=

# ---- Free tier (optional overrides) ----
# Free checks per person (canonical email), lifetime
FREE_REVIEW_LIMIT=1
# Free checks from one IP in 24h, across all accounts
FREE_REVIEWS_PER_IP_PER_DAY=3
# Service-wide daily cap on free checks (AI budget circuit breaker)
FREE_REVIEWS_GLOBAL_PER_DAY=200
# Per-user hourly speed bump on reviews (Pro included)
REVIEWS_PER_USER_PER_HOUR=20

# ---- Public (inlined into the browser bundle at build time) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL for Stripe and email redirects
NEXT_PUBLIC_APP_URL=https://guardconstruct.com
