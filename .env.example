# Server only — never expose these to the browser
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional: used to sign session tokens (generate a long random string)
AUTH_SECRET=
# Optional: public site URL for Stripe redirects
NEXT_PUBLIC_APP_URL=https://guardconstruct.com
# Stripe no-code customer portal login link (Stripe Dashboard > Settings > Billing > Customer portal)
NEXT_PUBLIC_STRIPE_PORTAL_LOGIN_URL=
